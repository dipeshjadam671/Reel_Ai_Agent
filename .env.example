# ==============================================================================
# Autonomous AI Video Generation & Publishing Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="Autonomous Video AI Platform"
API_V1_PREFIX=/api/v1
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Multi-Tenant & Budget Defaults
DEFAULT_WORKSPACE_BUDGET_USD=50.00
MAX_CYCLE_RETRIES=3
APPROVAL_TIMEOUT_HOURS=72

# Database & Cache
# Local PostgreSQL with pgvector support
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_ai_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/video_ai_db
REDIS_URL=redis://localhost:6379/0

# Object Storage (Local / S3 / MinIO)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/video_ai_platform/storage
S3_BUCKET_NAME=video-ai-platform-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# ==============================================================================
# MOCK SWITCH: When true, runs completely offline with simulated providers
# ==============================================================================
MOCK_EXTERNAL_APIS=true

# LLM Providers & Router
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_REASONING_MODEL=gpt-4o
LLM_FALLBACK_MODEL=gemini-1.5-flash

# Web Search Provider (Tavily / DuckDuckGo / SerpAPI)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Media Providers (Pexels / Unsplash / Storyblocks)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# TTS Providers (ElevenLabs / OpenAI / EdgeTTS)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Avatar / Presenter Providers (HeyGen / D-ID / SadTalker)
AVATAR_PROVIDER=heygen
HEYGEN_API_KEY=
DID_API_KEY=

# Social Media Publishing APIs
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/callback/youtube

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/callback/instagram

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/callback/tiktok

# Webhook Security
WEBHOOK_SECRET=dev-webhook-signature-secret
